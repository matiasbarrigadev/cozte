# Clerk: create a development application with Organizations enabled.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Private D1 bridge Worker. Never expose these with NEXT_PUBLIC_.
DATA_BRIDGE_URL=
DATA_BRIDGE_SECRET=

# Vercel AI Gateway; required for Cozte AI locally and in Vercel Production.
AI_GATEWAY_API_KEY=
# Optional Cozte model settings (AI Gateway model ids). Defaults: minimax/minimax-m3 with a 24000-token thinking budget.
# COZTE_FALLBACK_MODELS is a comma-separated list the gateway tries if the main model fails.
COZTE_MODEL=
COZTE_FALLBACK_MODELS=
# Extended-thinking budget per model step (1024-64000).
COZTE_THINKING_BUDGET=
# TypeSafe Jev reviews each answer through the AI Gateway: "revise" (default) rewrites clear failures once, "observe" only scores, "off" disables it.
COZTE_QUALITY=
COZTE_QUALITY_MODEL=
# Past this many milliseconds a turn is only scored, never rewritten (default 40000).
COZTE_QUALITY_MAX_MS=
CRON_SECRET=

# Optional. FXRatesAPI /latest works without a key on its public limited tier.
# For an account-specific quota, create a key at https://fxratesapi.com/ and
# add it as FXRATES_API_KEY in Vercel Production (server-only, no NEXT_PUBLIC_).
FXRATES_API_KEY=

# Cloudflare R2; enable R2 and use a token restricted to the app bucket.
R2_ACCOUNT_ID=b16b057db473a7ca309e70724394acb6
R2_BUCKET=cozte-documents
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
